{
  "info": {
    "name": "Task Management API",
    "description": "REST API for the Task Manager app (Next.js + Neon PostgreSQL) and the Open-Meteo weather integration.\n\nRun the folders in order: Create Task saves the new task id to `taskId`, which the following requests use.\n\nSet `baseUrl` to `http://localhost:3000` to test locally.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://task-management-seven-blue.vercel.app" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const task = pm.response.json();",
                  "pm.test(\"Returns the created task\", () => {",
                  "  pm.expect(task.id).to.be.a(\"number\");",
                  "  pm.expect(task.title).to.eql(\"Buy groceries\");",
                  "  pm.expect(task.completed).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set(\"taskId\", task.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk and eggs\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Get All Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns an array containing the created task\", () => {",
                  "  const tasks = pm.response.json();",
                  "  pm.expect(tasks).to.be.an(\"array\");",
                  "  pm.expect(tasks.map((t) => t.id)).to.include(Number(pm.collectionVariables.get(\"taskId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Update Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Title and description are updated\", () => {",
                  "  const task = pm.response.json();",
                  "  pm.expect(task.title).to.eql(\"Buy groceries and fruit\");",
                  "  pm.expect(task.description).to.eql(\"Milk, eggs and apples\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Buy groceries and fruit\",\n  \"description\": \"Milk, eggs and apples\"\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Mark Task as Completed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Task is completed and title is kept\", () => {",
                  "  const task = pm.response.json();",
                  "  pm.expect(task.completed).to.eql(true);",
                  "  pm.expect(task.title).to.eql(\"Buy groceries and fruit\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Delete Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns confirmation\", () => pm.expect(pm.response.json().message).to.eql(\"Task deleted\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        },
        {
          "name": "Delete Missing Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Returns not found error\", () => pm.expect(pm.response.json().error).to.eql(\"Task not found\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          }
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Create Task Without Title",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Returns validation error\", () => pm.expect(pm.response.json().error).to.eql(\"Title is required\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"No title\"\n}" },
            "url": "{{baseUrl}}/api/tasks"
          }
        },
        {
          "name": "Update Task With Invalid Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Returns validation error\", () => pm.expect(pm.response.json().error).to.eql(\"Invalid id\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"completed\": true\n}" },
            "url": "{{baseUrl}}/api/tasks/abc"
          }
        },
        {
          "name": "Update Task With Invalid Completed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Returns validation error\", () => pm.expect(pm.response.json().error).to.eql(\"Completed must be a boolean\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"completed\": \"yes\"\n}" },
            "url": "{{baseUrl}}/api/tasks/1"
          }
        }
      ]
    },
    {
      "name": "Weather (Open-Meteo)",
      "item": [
        {
          "name": "Get Weather by City",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns current weather\", () => {",
                  "  const weather = pm.response.json();",
                  "  pm.expect(weather.city).to.eql(\"Tokyo\");",
                  "  pm.expect(weather.temperature).to.be.a(\"number\");",
                  "  pm.expect(weather.description).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/weather?city=Tokyo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "weather"],
              "query": [{ "key": "city", "value": "Tokyo" }]
            }
          }
        },
        {
          "name": "Get Weather for Unknown City",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Returns not found error\", () => pm.expect(pm.response.json().error).to.eql(\"City not found\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/weather?city=zzqqxxnotacity",
              "host": ["{{baseUrl}}"],
              "path": ["api", "weather"],
              "query": [{ "key": "city", "value": "zzqqxxnotacity" }]
            }
          }
        },
        {
          "name": "Get Weather Without City",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Returns validation error\", () => pm.expect(pm.response.json().error).to.eql(\"City is required\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/weather"
          }
        }
      ]
    }
  ]
}
